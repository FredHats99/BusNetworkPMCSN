function(check fixture key expected)
  execute_process(COMMAND "${EXE}" simulate network "${FIXTURES}/${fixture}.txt" RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${fixture}: ${err}")
  endif()
  string(JSON value GET "${output}" ${key})
  if(NOT "${value}" STREQUAL "${expected}")
    message(FATAL_ERROR "${fixture} ${key}: expected ${expected}, got ${value}")
  endif()
endfunction()
check(network_service arrivals 3)
check(network_service boarded 3)
check(network_service completed 1)
check(network_service onboard 2)
check(network_service queue_area 2)
check(network_service occupancy_area 38)
check(network_reservation arrivals 2)
check(network_reservation boarded 2)
check(network_reservation queue_area 6)
check(network_closure boarded 1)
check(network_closure unserved 1)
check(network_closure queue_area 7)
check(network_horizon boarded 0)
check(network_horizon reserved 1)
check(network_horizon unserved 1)
check(network_horizon queue_area 4)
file(READ "${FIXTURES}/network_horizon.txt" valid)
string(REPLACE "PMNET1 0 4 0 0" "PMNET1 0 4 nan 0" invalid "${valid}")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/invalid_network.txt" "${invalid}")
execute_process(COMMAND "${EXE}" simulate network "${CMAKE_CURRENT_BINARY_DIR}/invalid_network.txt" RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
if(rc EQUAL 0)
  message(FATAL_ERROR "Nonfinite network configuration accepted")
endif()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/existing_trace.csv" "preserve me\n")
execute_process(COMMAND "${EXE}" simulate network "${FIXTURES}/network_horizon.txt" --trace "${CMAKE_CURRENT_BINARY_DIR}/existing_trace.csv" RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
file(READ "${CMAKE_CURRENT_BINARY_DIR}/existing_trace.csv" preserved)
if(rc EQUAL 0 OR NOT preserved STREQUAL "preserve me\n")
  message(FATAL_ERROR "Trace did not preserve an existing file")
endif()
